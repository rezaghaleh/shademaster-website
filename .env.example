# Copy to .env.local for development. Never commit the copy — .env.local is
# gitignored and holds real credentials.
#
# NEXT_PUBLIC_* values are baked into the JavaScript bundle at BUILD time, not
# read when the server starts. On a host that builds your container, they must
# be set as build variables, not just runtime ones, or the built site will still
# point at localhost.

# Where the admin UI sends its API calls.
# Also becomes the CSP's connect-src, so a wrong value here shows up as an admin
# screen that cannot reach its own backend.
# Production: https://api.your-domain.ca
NEXT_PUBLIC_ADMIN_API_BASE=http://localhost:8080

# Public origin of this site. Used as metadataBase, so Open Graph and Twitter
# preview images resolve to absolute URLs when the site is shared.
# Production: https://your-domain.ca
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- contact form mailbox (server-side only, never exposed to the browser) ---
EMAIL_USER=
EMAIL_PASS=
RECEIVER_EMAIL=
